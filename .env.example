# Server Configuration
PORT=3001
NODE_ENV=development

# Публічна адреса сайту (у dev — Vite). Від неї будуються OAuth redirect URI:
#   FACEIT:  ${APP_URL}/api/auth/faceit/callback
#   Discord: ${APP_URL}/api/discord/callback
APP_URL=http://localhost:5173

# SQLite (шлях відносно папки prisma/)
DATABASE_URL=file:../server/data/app.db
SESSION_TTL_DAYS=30

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_MAX=10

# FACEIT — https://developers.faceit.com (App Studio)
# OAuth-клієнт (FACEIT Connect) для входу
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
# Server-side API key для Data API (рівень, ELO, статистика, імпорт матчів)
FACEIT_API_KEY=

# FACEIT ID або нікнейми адміністраторів через кому
ADMIN_FACEIT_IDS=

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PLAYER_ROLE_ID=
DISCORD_CAPTAIN_ROLE_ID=
DISCORD_TEAMS_CATEGORY_ID=

# SMTP для кодів підтвердження. Порожній SMTP_HOST → код виводиться в консоль сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UNBREAKABLE PHOENIX <no-reply@unbreakable-phoenix.ua>

# Учасники команди мають бути з одного ЗВО
TEAM_SAME_UNIVERSITY=true

# Вхід без FACEIT для локальної розробки (ігнорується в production)
DEV_LOGIN=false

# Optional: Grand Final Date ISO string (leave empty for "Дату буде оголошено")
VITE_GRAND_FINAL_DATE=2026-11-01T12:00:00+02:00

# Microsoft Clarity Project ID
VITE_CLARITY_ID=z6kaj97kz1

# Telegram Bot Username for campaigns and notifications (t.me/<BOT>?start=<campaign>)
VITE_TELEGRAM_BOT_USERNAME=unbreakable_phoenix_bot

# Google Apps Script Web App URL for Application Form Submissions (Google Sheets)
VITE_GOOGLE_SCRIPT_URL=
